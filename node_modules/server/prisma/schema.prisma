generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String?
  shopName     String?
  businessType String?
  city         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products         Product[]
  customers        Customer[]
  transactions     Transaction[]
  insights         Insight[]
  campaigns        Campaign[]
  forecasts        ForecastSnapshot[]
  growthScores     GrowthScore[]
  chatMessages     ChatMessage[]
  expenses         Expense[]
}

model Otp {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Product {
  id         String   @id @default(uuid())
  merchantId String
  name       String
  category   String?
  price      Float
  cost       Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([merchantId])
}

model Customer {
  id          String   @id @default(uuid())
  merchantId  String
  phoneHash   String?
  firstSeenAt DateTime @default(now())

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([merchantId])
}

model Transaction {
  id          String   @id @default(uuid())
  merchantId  String
  customerId  String?
  productId   String?
  amount      Float
  paymentMode String   // UPI, CARD, WALLET, CASH
  status      String   // SUCCESS, FAILED, PENDING
  createdAt   DateTime @default(now())

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([merchantId, createdAt])
}

model Insight {
  id         String   @id @default(uuid())
  merchantId String
  type       String   // SALES_DROP, CASHFLOW_WARNING, etc.
  severity   String   // LOW, MEDIUM, HIGH
  title      String
  cause      String?
  metricDelta Float?
  confidence Float?
  status     String   @default("NEW") // NEW, VIEWED, ACTIONED
  createdAt  DateTime @default(now())

  merchant       Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  recommendation Recommendation?

  @@index([merchantId, createdAt])
}

model Recommendation {
  id              String  @id @default(uuid())
  insightId       String  @unique
  title           String
  description     String
  estUpliftRupees Float?
  estExtraOrders  Int?
  confidence      Float?
  payload         String? // JSON

  insight   Insight    @relation(fields: [insightId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
}

model Campaign {
  id               String    @id @default(uuid())
  merchantId       String
  recommendationId String?
  name             String
  offerText        String
  discountValue    Float?
  minOrderValue    Float?
  startHour        Int?
  endHour          Int?
  audience         String?
  status           String    @default("DRAFT") // DRAFT, LIVE, COMPLETED, CANCELLED
  messageCopy      String?   // JSON {whatsapp, sms}
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  results        CampaignResult[]

  @@index([merchantId])
}

model CampaignResult {
  id           String   @id @default(uuid())
  campaignId   String
  date         DateTime
  redemptions  Int      @default(0)
  extraRevenue Float    @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model ForecastSnapshot {
  id         String   @id @default(uuid())
  merchantId String
  kind       String   // SALES, CASHFLOW
  horizon    String   // 1d, 7d, 30d
  data       String   // JSON
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, kind])
}

model GrowthScore {
  id         String   @id @default(uuid())
  merchantId String
  score      Float
  breakdown  String   // JSON
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
}

model ChatMessage {
  id         String   @id @default(uuid())
  merchantId String
  role       String   // user, assistant
  content    String
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
}

model Expense {
  id         String   @id @default(uuid())
  merchantId String
  category   String
  amount     Float
  dueDate    DateTime?
  recurring  Boolean  @default(false)
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}
